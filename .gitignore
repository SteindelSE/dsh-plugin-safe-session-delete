.pnp.js

# ----- build output -----------------------------------------------------
dist/
build/
*.tsbuildinfo

# The client bundle (src/client.js) is a build artifact produced by
# `node build.mjs`. It IS tracked because the harness reads it from
# the installed package on every profile boot; the `prepare` script
# regenerates it locally and on disk before each commit so the
# checked-in copy always matches the current source.

